{{- $compose := .Vars.compose -}}
{{- $app := get .Vars "app" -}}
{{- $networks := dict "default" (dict "external" true "name" .Runtime.NetworkName) -}}
{{- $connections := dict "default" (dict) -}}

{{- range $name, $target := get $app "networks" -}}
{{- $networks = merge $networks (dict $name (dict "external" true "name" (network $target.environment $target.namespace))) -}}
{{- $connections = merge $connections (dict $name (dict)) -}}
{{- end -}}

{{- with get $app "route_namespace" -}}
{{- $namespace := . -}}
{{- range $.Environments -}}
{{- $name := printf "env_%s" . -}}
{{- $networks = merge $networks (dict $name (dict "external" true "name" (network . $namespace))) -}}
{{- $connections = merge $connections (dict $name (dict)) -}}
{{- end -}}
{{- end -}}

{{- with get $app "network_alias" -}}
{{- $connections = merge $connections (dict "default" (dict "aliases" (list (printf "%s-%s" . $.Env)))) -}}
{{- end -}}

name: {{ quote .Runtime.ProjectName }}

services:
{{- range $name, $service := $compose.services }}
  {{ quote $name }}:
{{- $defaults := dict "restart" "always" -}}
{{- if not (or (get $service "network_mode") (get $service "networks")) -}}
{{- $defaults = merge $defaults (dict "networks" $connections) -}}
{{- end -}}
{{- if not (get $service "logging") -}}
{{- $defaults = merge $defaults (dict "logging" (dict "driver" "json-file" "options" (dict "max-size" "10m" "max-file" "3"))) -}}
{{- end -}}
{{- if and $.Runtime.Image (not (get $service "image")) -}}
{{- $defaults = merge $defaults (dict "image" $.Runtime.Image "pull_policy" "never") -}}
{{- end }}
{{ toYAML (merge $defaults $service) | indent 4 }}
{{- end }}

networks:
{{ toYAML (merge $networks (get $compose "networks")) | indent 2 }}

{{- range $name, $value := $compose }}
{{- if and (ne $name "services") (ne $name "networks") (ne $name "name") }}
{{ quote $name }}:
{{ toYAML $value | indent 2 }}
{{- end }}
{{- end }}
